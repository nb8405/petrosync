APP_NAME=PetroSync
PUMP_NAME=__SET_INSTALLATION_PUMP_NAME__
APP_TIMEZONE=Asia/Kolkata

NODE_ENV=production
PORT=5000
HOST=127.0.0.1
TRUST_PROXY=loopback, linklocal, uniquelocal

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=petrol_pump_management
PGUSER=petrosync
PGPASSWORD=change-this-database-password

# LAN-only HTTP example:
# CORS_ORIGINS=http://petrosync.local,http://192.168.1.10
# AUTH_COOKIE_ENABLED=false
# AUTH_COOKIE_SECURE=false

# HTTPS example:
CORS_ORIGINS=https://pump.example.com
AUTH_COOKIE_ENABLED=true
AUTH_COOKIE_SECURE=true
CSRF_ENABLED=true

JWT_SECRET=__GENERATE_RANDOM_48_BYTE_SECRET__
JWT_ISSUER=petrosync
JWT_ACCESS_EXPIRES_SECONDS=900
JWT_REFRESH_EXPIRES_SECONDS=28800

BACKUP_SIGNING_SECRET=__GENERATE_DIFFERENT_RANDOM_48_BYTE_SECRET__
BACKUP_ENCRYPTION_ENABLED=true
BACKUP_ENCRYPTION_SECRET=__GENERATE_ANOTHER_RANDOM_48_BYTE_SECRET__
AUTO_BACKUP_ENABLED=true
BACKUP_DIR=/opt/petrosync/server/backups
EXPORT_DIR=/opt/petrosync/server/exports
LOG_DIR=/opt/petrosync/server/logs
LOG_LEVEL=info
LOG_MAX_BYTES=10485760
LOG_MAX_FILES=10
LOG_COMPRESS_ARCHIVES=true
LOG_ACCESS_ENABLED=true

HEALTH_INTERNET_HOST=1.1.1.1
HEALTH_INTERNET_PORT=53
HEALTH_INTERNET_TIMEOUT_MS=1500
NGINX_HEALTH_URL=http://127.0.0.1/healthz
ATOS_HEALTH_URL=
PRINTER_HEALTH_MODE=placeholder

SHUTDOWN_TIMEOUT_MS=30000

# Let NGINX perform the primary gateway rate limit. The app-level limiter stays
# available for non-proxy deployments by changing RATE_LIMIT_MODE back to memory.
RATE_LIMIT_MODE=gateway
TRUST_GATEWAY_RATE_LIMIT=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

JSON_BODY_LIMIT=25mb
CONTENT_SECURITY_POLICY="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ws: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"

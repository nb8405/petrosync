# ─────────────────────────────────────────────────────────────
# PetroSync / Petrol Pump Management — root .gitignore
# Protects secrets, dumps, logs, build output, and dependencies.
# ─────────────────────────────────────────────────────────────

# Secrets / environment (NEVER commit real values)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Credentials & keys (defensive — none currently in repo, keep it that way)
*.pem
*.key
*.ppk
*.crt
*.p12
*.pfx
id_rsa*
id_ed25519*
.aws/
.ssh/
*.keystore
serviceAccount*.json
gcp-*.json
firebase-adminsdk*.json

# Database dumps / backups / exports (contain PII & business data)
server/backups/
server/exports/
backups/
exports/
*.dump
*.sql.gz

# Logs
server/logs/
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependencies
node_modules/
**/node_modules/
.npm-cache/
.pnp
.pnp.js

# Build / preview output
client/build/
client/dist/
client/tmp-preview/
server/dist/
dist/
build/
.vite/
coverage/

# Nested / stray VCS metadata (e.g. accidental client/src/.git)
client/src/.git/

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
# ==========================================================
# AI Development Tools
# ==========================================================
.codex/
.claude/
.junie/
.agents/

# ==========================================================
# Runtime & Cache
# ==========================================================
.cache/
temp/
tmp/
*.tmp
*.temp

# ==========================================================
# Databases
# ==========================================================
*.db
*.sqlite
*.sqlite3
*.bak

# ==========================================================
# Archives
# ==========================================================
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# ==========================================================
# Python (if used for ML/AI later)
# ==========================================================
__pycache__/
*.pyc

# ==========================================================
# Test Reports
# ==========================================================
playwright-report/
test-results/
.nyc_output/

# ==========================================================
# Local Tool Configuration
# ==========================================================
.codex/
.claude/

# ==========================================================
# Local AI Memory / Sessions
# ==========================================================
.codex/auth.json
.codex/state*
.codex/log*
.codex/memories*
.codex/goals*
.codex/rollouts*

# ==========================================================
# Docker
# ==========================================================
docker-compose.override.yml

# ==========================================================
# Misc
# ==========================================================
*.orig

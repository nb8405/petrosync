# ─────────────────────────────────────────────────────────────
# Server environment template — copy to server/.env and fill in.
# DO NOT put real secrets in this file. server/.env is gitignored.
# Generate strong secrets with:  openssl rand -base64 48
# ─────────────────────────────────────────────────────────────

# Runtime
PORT=5000
# Bind to 127.0.0.1 in production so only the reverse proxy can reach Node.
# Use 0.0.0.0 only for development or explicitly controlled lab environments.
HOST=127.0.0.1
NODE_ENV=development

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=petrol_pump_management
PGUSER=postgres
PGPASSWORD=__CHANGE_ME__
# Optional single connection string alternative:
# DATABASE_URL=postgresql://user:password@localhost:5432/petrol_pump_management
# Used by server tests (optional):
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/petrol_pump_test

# CORS (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Set when the app is behind NGINX/Caddy/HAProxy. Production defaults to
# loopback/link-local/private proxy ranges if not specified.
TRUST_PROXY=loopback, linklocal, uniquelocal

# JWT / sessions  (secrets MUST be >= 32 chars in production)
JWT_SECRET=__CHANGE_ME_AT_LEAST_32_CHARS__
JWT_ISSUER=petrol-pump-management
JWT_AUDIENCE=petrosync-api
JWT_CLOCK_TOLERANCE_SECONDS=30
JWT_ACCESS_EXPIRES_SECONDS=900
JWT_REFRESH_EXPIRES_SECONDS=28800

# Backup signing (>= 32 chars in production)
BACKUP_SIGNING_SECRET=__CHANGE_ME_AT_LEAST_32_CHARS__
BACKUP_ENCRYPTION_ENABLED=true
BACKUP_ENCRYPTION_SECRET=__CHANGE_ME_DIFFERENT_32_CHARS__

# Auth cookies / CSRF
AUTH_COOKIE_ENABLED=false
AUTH_COOKIE_SECURE=true
CSRF_ENABLED=true

# Rate limiting
RATE_LIMIT_MODE=memory
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Request body size cap
JSON_BODY_LIMIT=25mb

# Enterprise structured logging
LOG_DIR=logs
LOG_LEVEL=info
LOG_MAX_BYTES=10485760
LOG_MAX_FILES=10
LOG_COMPRESS_ARCHIVES=true
LOG_ACCESS_ENABLED=true

# Health monitoring
HEALTH_INTERNET_HOST=1.1.1.1
HEALTH_INTERNET_PORT=53
HEALTH_INTERNET_TIMEOUT_MS=1500
# Optional local proxy check, for example http://127.0.0.1/healthz
NGINX_HEALTH_URL=
# Optional ATOS/ATG health endpoint if available on the LAN
ATOS_HEALTH_URL=
PRINTER_HEALTH_MODE=placeholder

# Graceful shutdown
SHUTDOWN_TIMEOUT_MS=30000
